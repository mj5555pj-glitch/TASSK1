{
  "entities": {
    "Task": {
      "title": "MaintenanceTask",
      "description": "An internet maintenance task dispatched to a field technician",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "taskNumber": { "type": "string" },
        "taskType": {
          "type": "string",
          "enum": ["صيانة", "تنصيب", "ضعف", "مشاكل اخرى"]
        },
        "subscriberName": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 30 },
        "notes": { "type": "string", "maxLength": 1000 },
        "assignedToId": { "type": "string" },
        "assignedToName": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string" },
        "acceptedAt": { "type": "string" },
        "pausedAt": { "type": "string" },
        "resumedAt": { "type": "string" },
        "pauseReason": { "type": "string", "maxLength": 500 },
        "accumulatedSeconds": { "type": "number" },
        "completedAt": { "type": "string" },
        "durationSeconds": { "type": "number" },
        "durationFormatted": { "type": "string" },
        "completionNotes": { "type": "string", "maxLength": 1000 },
        "expiresAt": { "type": "string" },
        "lastBroadcastAt": { "type": "string" },
        "resentCount": { "type": "number" },
        "status": {
          "type": "string",
          "enum": ["pending", "in_progress", "paused", "completed"]
        }
      },
      "required": ["taskNumber", "taskType", "subscriberName", "phone", "createdAt", "status"]
    },
    "User": {
      "title": "User",
      "description": "System manager or technician account credentials and profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "password": { "type": "string" },
        "fullName": { "type": "string" },
        "role": { "type": "string", "enum": ["manager", "technician"] },
        "phone": { "type": "string" },
        "specialty": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "username", "password", "fullName", "role"]
    },
    "Settings": {
      "title": "WhatsAppTemplateSettings",
      "description": "Global system settings such as the customizable subscriber WhatsApp message template",
      "type": "object",
      "properties": {
        "template": { "type": "string", "maxLength": 4000 },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      },
      "required": ["template"]
    }
  },
  "firestore": {
    "/tasks/{taskId}": {
      "schema": "Task",
      "description": "Collection of dispatched ISP maintenance tasks"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection of users and technician accounts"
    },
    "/settings/{settingId}": {
      "schema": "Settings",
      "description": "Collection of global app settings such as the WhatsApp message template"
    }
  }
}
