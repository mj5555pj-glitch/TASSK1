{
  "entities": {
    "Task": {
      "title": "MaintenanceTask",
      "description": "An internet maintenance task dispatched to a field technician",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "taskNumber": { "type": "string" },
        "taskType": {
          "type": "string",
          "enum": ["صيانة", "تنصيب", "ضعف", "مشاكل اخرى"]
        },
        "subscriberName": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 30 },
        "notes": { "type": "string", "maxLength": 1000 },
        "assignedToId": { "type": "string" },
        "assignedToName": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string" },
        "acceptedAt": { "type": "string" },
        "pausedAt": { "type": "string" },
        "suspendedAt": { "type": "string" },
        "resumedAt": { "type": "string" },
        "pauseReason": { "type": "string", "maxLength": 500 },
        "suspendReason": { "type": "string", "maxLength": 500 },
        "accumulatedSeconds": { "type": "number" },
        "completedAt": { "type": "string" },
        "durationSeconds": { "type": "number" },
        "durationFormatted": { "type": "string" },
        "completionNotes": { "type": "string", "maxLength": 1000 },
        "expiresAt": { "type": "string" },
        "lastBroadcastAt": { "type": "string" },
        "resentCount": { "type": "number" },
        "originallyBroadcast": { "type": "boolean" },
        "deductionExempt": { "type": "boolean" },
        "deductionExemptReason": { "type": "string", "maxLength": 300 },
        "acceptDeductionApplied": { "type": "boolean" },
        "acceptDeductionAmount": { "type": "number" },
        "completionDeductionApplied": { "type": "boolean" },
        "completionDeductionAmount": { "type": "number" },
        "status": {
          "type": "string",
          "enum": ["pending", "in_progress", "paused", "suspended", "completed"]
        }
      },
      "required": ["taskNumber", "taskType", "subscriberName", "phone", "createdAt", "status"]
    },
    "User": {
      "title": "User",
      "description": "System manager or technician account credentials, profile, and deduction balance",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "password": { "type": "string" },
        "fullName": { "type": "string" },
        "role": { "type": "string", "enum": ["manager", "technician"] },
        "phone": { "type": "string" },
        "specialty": { "type": "string" },
        "status": { "type": "string" },
        "deductionBalance": { "type": "number" }
      },
      "required": ["id", "username", "password", "fullName", "role"]
    },
    "Settings": {
      "title": "SystemSettings",
      "description": "Global system settings including WhatsApp message template and employee delay deduction rules",
      "type": "object",
      "properties": {
        "template": { "type": "string", "maxLength": 4000 },
        "enabled": { "type": "boolean" },
        "unitLabel": { "type": "string", "maxLength": 30 },
        "acceptDelayMinutes": { "type": "number" },
        "acceptDelayDeduction": { "type": "number" },
        "completionDelayMinutes": { "type": "number" },
        "completionDelayDeduction": { "type": "number" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      }
    },
    "DeductionRecord": {
      "title": "DeductionRecord",
      "description": "Recorded automatic deduction applied to a technician for accept or completion delay on their primary task",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "taskId": { "type": "string" },
        "taskNumber": { "type": "string" },
        "reason": { "type": "string", "enum": ["accept_delay", "completion_delay"] },
        "delayMinutes": { "type": "number" },
        "allowedMinutes": { "type": "number" },
        "amount": { "type": "number" },
        "unitLabel": { "type": "string" },
        "createdAt": { "type": "string" },
        "note": { "type": "string", "maxLength": 300 }
      },
      "required": ["id", "userId", "userName", "taskId", "taskNumber", "reason", "amount", "createdAt"]
    }
  },
  "firestore": {
    "/tasks/{taskId}": {
      "schema": "Task",
      "description": "Collection of dispatched ISP maintenance tasks"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection of users and technician accounts"
    },
    "/settings/{settingId}": {
      "schema": "Settings",
      "description": "Collection of global app settings (whatsapp template, deduction rules)"
    },
    "/deductions/{deductionId}": {
      "schema": "DeductionRecord",
      "description": "Collection of technician delay deduction records"
    }
  }
}
