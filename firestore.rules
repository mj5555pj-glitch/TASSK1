rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Tasks collection for ISP maintenance dispatch
    match /tasks/{taskId} {
      allow read, write: if true;
    }

    // Users collection for managers and technicians accounts management
    match /users/{userId} {
      allow read, write: if true;
    }

    // Settings collection for global WhatsApp message template managed by manager
    match /settings/{settingId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
