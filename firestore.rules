rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Tasks collection for ISP maintenance dispatch
    match /tasks/{taskId} {
      allow read: if true;
      allow create: if request.resource.data.taskType in ['صيانة', 'تنصيب', 'ضعف', 'مشاكل اخرى']
                    && request.resource.data.subscriberName is string
                    && request.resource.data.phone is string;
      allow update: if true;
      allow delete: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
